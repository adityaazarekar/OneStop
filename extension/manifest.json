{
  "manifest_version": 3,
  "name": "OneStop – Price Intelligence for India",
  "version": "1.0.0",
  "description": "Real-time price comparison, credit card optimizer, seller trust scores & buy/wait verdicts for Indian e-commerce.",
  "permissions": ["storage", "activeTab", "scripting", "offscreen"],
  "host_permissions": [
    "https://*/*",
    "http://*/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": ["dom_extractor.js", "content_script.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
